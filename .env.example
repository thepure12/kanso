# Runtime connection (RLS enforced)
NUXT_DATABASE_URL=postgres://kanban_app:kanban_app@localhost:5432/kanban
# Auth handlers only (login / register / OAuth callback)
NUXT_AUTH_DATABASE_URL=postgres://kanban_auth:kanban_auth@localhost:5432/kanban
# Migrations (drizzle-kit)
MIGRATION_DATABASE_URL=postgres://kanban_owner:kanban_owner@localhost:5432/kanban

# At least 32 characters
NUXT_SESSION_PASSWORD=change-me-to-a-random-string-of-32-chars-or-more
# Optional key (32+ chars) for two-factor secrets at rest. Empty: derived from
# NUXT_SESSION_PASSWORD. Changing it makes existing two-factor secrets unreadable.
NUXT_TOTP_KEY=

NUXT_OAUTH_DISCORD_CLIENT_ID=
NUXT_OAUTH_DISCORD_CLIENT_SECRET=
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Serve the app under a sub-path, e.g. https://example.org/kanso/. Read at build
# time (pnpm build, Docker build arg), so rebuild after changing it. Include the
# path in NUXT_PUBLIC_SITE_URL too (https://example.org/kanso). Unset: the root.
# Leave the line commented out rather than empty.
# NUXT_APP_BASE_URL=/kanso/

# Instance admin. This email can always sign up and becomes admin once it is
# verified. Sign-up rules (open or restricted, allowed domains and emails,
# invites from outside them) are set by admins at /admin. A fresh install starts
# restricted with empty lists: only this email (and invites) can sign up.
NUXT_ADMIN_EMAIL=

# Password sign-ups must confirm their email through a mailed link. Without an
# SMTP URL the dev server logs the link to the console (NUXT_MAIL_LOG_LINKS,
# on by default in development). Set all three in production.
NUXT_PUBLIC_SITE_URL=
NUXT_MAIL_SMTP_URL=
NUXT_MAIL_FROM=Kanban <kanban@example.com>

# Webhooks only reach public addresses. true lets them reach loopback and
# private networks: for development and tests only (it allows SSRF).
NUXT_WEBHOOK_ALLOW_PRIVATE=

# Production compose only (docker-compose.prod.yml). Hex passwords
# (openssl rand -hex 32): the role passwords go into connection URLs.
KANBAN_DOMAIN=
POSTGRES_PASSWORD=
KANBAN_OWNER_PASSWORD=
KANBAN_APP_PASSWORD=
KANBAN_AUTH_PASSWORD=
